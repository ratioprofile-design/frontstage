{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'Static browser client: no package installation required'",
  "buildCommand": "node scripts/build-web.mjs",
  "outputDirectory": "build/web",
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; connect-src 'self' https:; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; frame-ancestors 'none'" }
    ] },
    { "source": "/config.js", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Service-Worker-Allowed", "value": "/" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
